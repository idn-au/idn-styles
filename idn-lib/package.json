{
    "name": "@idn-au/idn-lib",
    "type": "module",
    "version": "1.0.0",
    "description": "A Vue.js component library for shared IDN components",
    "license": "BSD-3-Clause",
    "homepage": "https://github.com/idn-au/idn-styles/blob/main/README.md",
    "repository": {
        "type": "git",
        "url": "https://github.com/idn-au/idn-styles"
    },
    "bugs": {
        "url": "https://github.com/idn-au/idn-styles/issues"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/idn-lib.js",
            "require": "./dist/idn-lib.umd.cjs"
        },
        "./idn-lib.css": {
            "import": "./dist/idn-lib.css",
            "require": "./dist/idn-lib.css"
        }
    },
    "main": "./dist/idn-lib.umd.cjs",
    "module": "./dist/idn-lib.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc && vite build",
        "lint": "eslint . --fix --cache",
        "test": "vitest",
        "types": "vue-tsc",
        "preview": "vite preview",
        "preinstall": "npx only-allow pnpm"
    },
    "peerDependencies": {
        "vue": "^3.0.0"
    },
    "dependencies": {
        "@lucide/vue": "^1.64.0",
        "@tailwindcss/vite": "^4.3.3",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "reka-ui": "^2.11.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^10.0.0",
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-brands-svg-icons": "^7.3.1",
        "@fortawesome/vue-fontawesome": "^3.3.3",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "eslint": "^10.13.0",
        "eslint-plugin-format": "^2.0.1",
        "typescript": "6.0.3",
        "vite": "^8.3.5",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^5.0.5",
        "vue-tsc": "3.3.13"
    }
}
